# Copy to .env and fill in. Never commit .env.
# gemini | groq | ollama | off
LLM_PROVIDER=off
# Required for gemini (aistudio.google.com) and groq (console.groq.com); not used by ollama.
# Put each provider's key in its own variable so you can switch LLM_PROVIDER freely; the
# provider's own variable wins over LLM_API_KEY, so a key is never sent to another provider.
GEMINI_API_KEY=
GROQ_API_KEY=
# Generic fallback, used when the provider's own variable above is empty
LLM_API_KEY=
# Defaults: gemini-3.5-flash-lite (gemini), llama-3.3-70b-versatile (groq).
# Required for ollama: the name of a model you've pulled, e.g. qwen2.5-coder:7b
LLM_MODEL=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
