# Copy to .env and fill in. Never commit .env.
# gemini | groq | ollama | off
LLM_PROVIDER=off
# Required for gemini (aistudio.google.com) and groq (console.groq.com); not used by ollama
LLM_API_KEY=
# Defaults: gemini-2.5-flash (gemini), llama-3.3-70b-versatile (groq).
# Required for ollama: the name of a model you've pulled, e.g. qwen2.5-coder:7b
LLM_MODEL=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
